<UserControl xmlns="https://github.com/avaloniaui"      
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:behaviors="using:CyclingIntervalsGui.Behaviors"
        x:Class="CyclingIntervalsGui.Views.IntervalsUserControl"
        xmlns:vm="clr-namespace:CyclingIntervalsGui.ViewModels"
        x:DataType="vm:IntervalsViewModel">

    <!-- <UserControl.DataContext>
    </UserControl.DataContext> -->

    <avaPlot:AvaPlot x:Name="Intervals" 
                    behaviors:IntervalsUpdateBehavior.IntervalsSource="{Binding IntervalsList}"
                    behaviors:PlotSyncBehavior.IsSynced="True"/>

</UserControl>