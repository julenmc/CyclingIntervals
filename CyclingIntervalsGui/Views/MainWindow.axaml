<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CyclingIntervalsGui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:behaviors="using:CyclingIntervalsGui.Behaviors"
        xmlns:views="clr-namespace:CyclingIntervalsGui.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CyclingIntervalsGui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CyclingIntervalsGui">

    <Design.DataContext>
        <!-- DataContext para el previewer en el IDE -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="4*,*">
        <!-- Graphs with synchronized zoom -->
        <Grid Grid.Column="0" RowDefinitions="*,*,*,*">
            <views:GraphUserControl Grid.Row="0" 
                    DataContext="{Binding AltitudeViewModel}"/>
            <views:GraphUserControl Grid.Row="1" 
                    DataContext="{Binding PowerViewModel}"/>
            <views:GraphUserControl Grid.Row="2" 
                    DataContext="{Binding HrViewModel}"/>
            <views:IntervalsUserControl Grid.Row="3"
                    RectangleClickedCommand="{Binding HandleRectangleClickCommand}"
                    DataContext="{Binding IntervalsViewModel}"/>  
        </Grid>

        <!-- Configuration grid -->
        <ScrollViewer Grid.Column="1"> 
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                <!-- File -->
                <Grid Grid.Row="0" RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="10" Orientation="Horizontal">
                        <TextBlock Text="File:" VerticalAlignment="Center" FontWeight="Bold" Margin="10,10,10,10"/>
                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Foreground="DarkGray" Margin="0,10,10,10"/>
                    </StackPanel>
                    <Button 
                        Grid.Row="1" 
                        Command="{Binding OpenFileCommand}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        Select</Button>
                </Grid>
                <!-- Visualization -->
                <StackPanel Grid.Row="1" Spacing="10" Orientation="Vertical">
                    <TextBlock Text="Show:" VerticalAlignment="Center" FontWeight="Bold" Margin="5,5,5,5"/>
                    <CheckBox 
                        IsChecked="{Binding ShowClimbs}"
                        Content="Climbs"/>
                    <CheckBox 
                        IsChecked="{Binding ShowIntervals}"
                        Content="Intervals"/>
                </StackPanel>
                <!-- Thresholds -->
                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="10" Orientation="Horizontal">
                        <TextBlock Text="Thresholds:" VerticalAlignment="Center" FontWeight="Bold" Margin="10,10,10,10"/>
                    </StackPanel>
                </Grid>
                <!-- Zones -->
                <views:ZonesUserControl Grid.Row="3" 
                                        DataContext="{Binding ZonesViewModel}"/>
            </Grid>
        </ScrollViewer>
    </Grid>

</Window>

